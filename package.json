{
  "name": "storeassist-ai",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "check:content": "node scripts/check-content.ts",
    "db:generate": "pnpm --filter @storeassist/api exec drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=apps/api/.dev.vars scripts/migrate.ts",
    "ingest": "node --env-file-if-exists=apps/api/.dev.vars scripts/ingest.ts",
    "search": "node --env-file-if-exists=apps/api/.dev.vars scripts/search.ts",
    "chat": "node scripts/chat.ts",
    "eval": "node --env-file-if-exists=apps/api/.dev.vars scripts/eval.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~5.0.5"
  }
}
